{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "honeydrunk-website",
  "account_id": "32602ca412fd35c59329a93362cc5e60",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "honeydrunkstudios.com", "custom_domain": true },
    { "pattern": "www.honeydrunkstudios.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "honeydrunk-website" }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
